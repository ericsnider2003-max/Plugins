{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage-max/task/v1",
  "title": "Usage-max durable task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "taskId", "state", "createdAt", "updatedAt", "attempt", "idempotencyKey", "checkpoint", "effects"],
  "properties": {
    "contract": { "const": "usage-max.task.v1" },
    "taskId": { "type": "string", "minLength": 8 },
    "state": { "enum": ["queued", "admitted", "running", "checkpointing", "handoff_pending", "recovery_required", "paused_for_usage", "paused_for_approval", "verifying", "completed", "failed", "dead_letter"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "attempt": { "type": "integer", "minimum": 0 },
    "idempotencyKey": { "type": "string", "minLength": 8 },
    "assigned": { "type": "boolean" },
    "executionMode": { "enum": ["interactive", "unattended"] },
    "governance": { "type": ["object", "null"], "additionalProperties": false, "required": ["required", "policyRevision", "status", "failClosed"], "properties": { "required": { "type": "boolean" }, "policyRevision": { "type": "string", "minLength": 1 }, "status": { "enum": ["active", "unavailable"] }, "failClosed": { "type": "boolean" }, "reminderVersion": { "type": "integer", "minimum": 1 }, "lastRemindedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "unattendedPolicy": { "type": ["object", "null"], "additionalProperties": false, "properties": { "maxSessions": { "type": "integer", "minimum": 1 }, "maxWallClockMs": { "type": "integer", "minimum": 1 }, "maxRetries": { "type": "integer", "minimum": 0 }, "emergencyStopPath": { "type": "string" } } },
    "supervisor": { "type": ["object", "null"], "additionalProperties": false, "properties": { "launchId": { "type": ["string", "null"] }, "sessionCount": { "type": "integer", "minimum": 0 }, "lastOutcome": { "type": ["string", "null"] }, "stopReason": { "type": ["string", "null"] }, "updatedAt": { "type": "string", "format": "date-time" } } },
    "authorization": { "type": "object", "additionalProperties": false, "properties": { "repositoryActions": { "type": "array", "items": { "enum": ["install", "commit"] }, "uniqueItems": true } } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "retry": { "type": "object", "additionalProperties": false, "properties": { "maxAttempts": { "type": "integer", "minimum": 0 }, "baseDelayMs": { "type": "integer", "minimum": 1000 }, "maxDelayMs": { "type": "integer", "minimum": 1000 } } },
    "retryAt": { "type": "string", "format": "date-time" },
    "deadlineAt": { "type": ["string", "null"], "format": "date-time" },
    "maxConcurrency": { "type": ["integer", "null"], "minimum": 1 },
    "budgetPolicy": { "type": "object", "additionalProperties": false, "properties": { "expectedStepPercent": { "type": "number", "minimum": 0, "maximum": 100 }, "maxStepPercent": { "type": "number", "minimum": 0, "maximum": 100 }, "reservePercent": { "type": "number", "minimum": 0, "maximum": 100 }, "requirePrediction": { "type": "boolean" } } },
    "priority": { "type": "integer" },
    "qualityRequired": { "enum": ["low", "standard", "high"] },
    "executionProfile": { "type": ["string", "null"], "enum": ["cheap", "standard", "thorough", null] },
    "requestedModel": { "type": ["string", "null"] },
    "requestedEffort": { "type": ["string", "null"] },
    "modelDecision": { "type": ["object", "null"], "additionalProperties": false, "required": ["status", "reason", "effective", "control", "decidedAt"], "properties": { "status": { "enum": ["unknown", "observed", "unchanged", "pending", "unavailable"] }, "reason": { "type": "string" }, "provider": { "type": ["string", "null"] }, "surface": { "type": ["string", "null"] }, "requested": { "type": ["object", "null"], "additionalProperties": false, "properties": { "model": { "type": ["string", "null"] }, "effort": { "type": ["string", "null"] } } }, "observed": { "type": ["object", "null"], "additionalProperties": false, "properties": { "model": { "type": ["string", "null"] }, "effort": { "type": ["string", "null"] } } }, "effective": { "type": ["object", "null"], "additionalProperties": false, "properties": { "model": { "type": ["string", "null"] }, "effort": { "type": ["string", "null"] } } }, "control": { "enum": ["supported", "unavailable"] }, "decidedAt": { "type": "string", "format": "date-time" } } },
    "verification": { "type": ["object", "null"], "additionalProperties": false, "required": ["complete", "checks", "missingEffects", "reason"], "properties": { "complete": { "type": "boolean" }, "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "passed", "evidence"], "properties": { "name": { "type": "string" }, "passed": { "type": "boolean" }, "evidence": { "type": ["string", "null"] } } } }, "missingEffects": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string" } } },
    "provider": { "type": ["string", "null"] },
    "surface": { "type": ["string", "null"] },
    "accountSlot": { "type": ["string", "null"] },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["version", "path", "digest"], "properties": { "version": { "type": "integer", "minimum": 0 }, "path": { "type": "string" }, "digest": { "type": "string", "minLength": 8 } } },
    "effects": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["effectId", "kind", "state"], "properties": { "effectId": { "type": "string", "minLength": 8 }, "kind": { "type": "string" }, "state": { "enum": ["planned", "started", "committed", "failed", "skipped"] }, "resultDigest": { "type": ["string", "null"] } } } },
    "lease": { "type": ["object", "null"], "additionalProperties": false, "properties": { "owner": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } } },
    "recovery": { "type": ["object", "null"], "additionalProperties": false, "required": ["reason", "requiredAt", "reconciled"], "properties": { "reason": { "type": "string" }, "requiredAt": { "type": "string", "format": "date-time" }, "reconciled": { "type": "boolean" }, "safeToRetry": { "type": "boolean" }, "reconciledAt": { "type": ["string", "null"], "format": "date-time" } } }
    ,"stop": { "type": ["object", "null"], "additionalProperties": false, "required": ["reason", "requestedAt"], "properties": { "reason": { "type": "string" }, "requestedAt": { "type": "string", "format": "date-time" } } }
  }
}
